import os
import sys

from snakemake.utils import min_version, validate
import pandas as pd
from pathlib import Path

min_version("9.0")


configfile: "config/config.yaml"


validate(config, "schemas/config.schema.yaml")

SCORESETS = pd.read_csv(
    config["scoresets"], sep="\t", dtype=str, keep_default_na=False
).set_index("id", drop=False)
validate(SCORESETS, "schemas/scoresets.schema.yaml")

DATA = os.environ.get("MAVECAL_DATA_DIR", config["data_dir"])
RES = config["results_dir"]
ANALYSES = list(config["analyses"])


wildcard_constraints:
    scoreset="|".join(SCORESETS.index),
    analysis="|".join(ANALYSES),
    release=r"\d{4}-\d{2}",


report: "report/workflow.rst"


sys.path.insert(0, os.path.join(workflow.basedir, "..", "src"))
from mavecal import manifest  # noqa: E402

RUN_DIR = f"{RES}/run"


include: "rules/common.smk"
include: "rules/data.smk"
include: "rules/analysis.smk"
include: "rules/figures.smk"


rule all:
    default_target: True
    input:
        final_outputs(),


localrules:
    fetch_mavedb,
    aggregate,


onstart:
    manifest.write_start(
        Path(RUN_DIR) / "manifest_start.json",
        config,
        manifest_inputs(),
        Path(workflow.basedir).parent / "docs" / "analysis_plan.md",
        Path(DATA),
    )


onsuccess:
    manifest.write_end(
        Path(RUN_DIR) / "manifest_end.json",
        Path(RUN_DIR) / "manifest_start.json",
        "success",
        Path(RES),
        # The handler variable log: the run's Snakemake log file paths (a list in 9.x).
        log,
    )


onerror:
    manifest.write_end(
        Path(RUN_DIR) / "manifest_end.json",
        Path(RUN_DIR) / "manifest_start.json",
        "error",
        Path(RES),
        # The handler variable log: the run's Snakemake log file paths (a list in 9.x).
        log,
    )
